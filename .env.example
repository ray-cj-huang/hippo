# Copy to .env. Never commit .env.

# --- Database (local: docker compose up -d db) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# session | transaction (Supabase pooler :6543 needs transaction)
DATABASE_POOL_MODE=session
# Production, only read by `pnpm db:migrate:prod`. Supabase session pooler URL.
PROD_DATABASE_URL=

# --- integrator ---
INTEGRATOR_PORT=4001
SLOT_TOKEN_SECRET=change-me-to-a-long-random-string
# Shared with phoner; every route except /health and /admin/* requires it. `openssl rand -hex 32`
INTEGRATOR_TOKEN=change-me-to-a-random-string-of-32-or-more-chars
# Serves /admin/snapshot (patient names and DOBs) to the console. Local development only.
ADMIN_ENABLED=true
CLINIC_NAME=Hippo Medical Center
CLINIC_TIMEZONE=America/Los_Angeles
BOOKING_WINDOW_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- phoner ---
PHONER_PORT=4000
INTEGRATOR_URL=http://localhost:4001
ALLOWED_ORIGINS=http://localhost:3000
# google | scripted
LLM_PROVIDER=google
LLM_MODEL=
GEMINI_API_KEY=
# deepgram-flux | none (typed input only)
STT_PROVIDER=deepgram-flux
DEEPGRAM_API_KEY=
FLUX_EOT_THRESHOLD=0.7
FLUX_EOT_TIMEOUT_MS=5000
# cartesia | silent
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# Cartesia plan concurrency limit
TTS_MAX_CONCURRENCY=1
GUARDRAIL=noop

# --- web (Next.js) ---
NEXT_PUBLIC_PHONER_URL=http://localhost:4000
NEXT_PUBLIC_INTEGRATOR_URL=http://localhost:4001
