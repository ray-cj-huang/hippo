{
  "name": "@hippo/integrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hippo/contracts": "workspace:*",
    "@hippo/db": "workspace:*",
    "@hono/node-server": "2.1.5",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hippo/tsconfig": "workspace:*",
    "postgres": "3.4.9",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
